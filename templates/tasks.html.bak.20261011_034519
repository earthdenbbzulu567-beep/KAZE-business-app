{% extends "base.html" %}
{% block content %}
<div class="page-header">
    <div>
        <h1>Tasks</h1>
        <p>Keep a running list of jobs for this business.</p>
    </div>
</div>
<div class="stat-grid">
    <div class="stat-chip"><span>Open</span><strong>{{ open_count }}</strong></div>
    <div class="stat-chip"><span>All</span><strong>{{ items|length }}</strong></div>
</div>
<details style="margin-bottom:1.5rem;" open>
    <summary>Add task</summary>
    <div>
        <form method="POST" action="{{ url_for('add_task') }}">
            <div class="form-group"><label>Title</label><input type="text" name="title" required placeholder="Call supplier"></div>
            <div class="form-group"><label>Priority</label>
                <select name="priority">
                    <option value="low">Low</option>
                    <option value="medium" selected>Medium</option>
                    <option value="high">High</option>
                </select>
            </div>
            <div class="form-group"><label>Due</label><input type="date" name="due_date"></div>
            <div class="form-group" style="display:block;width:100%;"><label>Notes</label>
                <textarea name="notes" rows="2" style="width:100%;max-width:640px;"></textarea>
            </div>
            <button type="submit">Save task</button>
        </form>

<details class="multi-wrap">
    <summary>Add several tasks</summary>
    <div>
        <form method="POST" action="{{ url_for('multi_add', kind='tasks') }}">
            <div class="table-wrapper">
            <table class="multi-table" id="multiTasks">
                <thead><tr><th>Title</th><th>Priority</th><th>Due</th><th>Notes</th><th><input type="checkbox" onclick="kazeToggleAll(this)"></th></tr></thead>
                <tbody>
                {% for _ in range(3) %}
                <tr class="multi-row">
                    <td><input type="text" name="title" placeholder="Task"></td>
                    <td><select name="priority"><option value="low">Low</option><option value="medium" selected>Medium</option><option value="high">High</option></select></td>
                    <td><input type="date" name="due_date"></td>
                    <td><input type="text" name="notes"></td>
                    <td><button type="button" class="btn-secondary multi-row-del" onclick="kazeDelRow(this)">×</button></td>
                </tr>
                {% endfor %}
                </tbody>
            </table>
            </div>
            <div class="multi-actions">
                <button type="button" class="btn-secondary" onclick="kazeAddRow('multiTasks')">+ Row</button>
                <button type="submit">Save all tasks</button>
            </div>
        </form>
    </div>
</details>


    </div>
</details>
<form method="POST" action="{{ url_for('tasks_bulk_complete') }}" onsubmit="return kazeConfirmBulk(this)">
<div style="margin-bottom:0.6rem;display:flex;gap:0.5rem;align-items:center;flex-wrap:wrap;">
    <select name="action">
        <option value="complete">Complete selected</option>
        <option value="reopen">Reopen selected</option>
        <option value="delete">Delete selected</option>
    </select>
    <button type="submit">Apply</button>
</div>
<div class="table-wrapper">
<table>
<thead><tr><th></th><th>Status</th><th>Task</th><th>Priority</th><th>Due</th><th>Action</th></tr></thead>
<tbody>
{% for item in items %}
<tr>
    <td><input type="checkbox" name="selected_ids" value="{{ item.id }}"></td>
    <td>{% if item.done %}<span class="status-pill status-ok">Done</span>{% else %}<span class="status-pill status-warn">Open</span>{% endif %}</td>
    <td><strong>{{ item.title }}</strong>{% if item.notes %}<div style="color:var(--text3);font-size:0.82rem;">{{ item.notes }}</div>{% endif %}</td>
    <td>{{ item.priority }}</td>
    <td>{{ item.due_date or '—' }}</td>
    <td>
        <a href="{{ url_for('toggle_task', id=item.id) }}">{% if item.done %}Reopen{% else %}Complete{% endif %}</a>
        <a href="{{ url_for('delete_task', id=item.id) }}" class="delete-btn" onclick="return confirm('Delete this task?')">Delete</a>
    </td>
</tr>
{% else %}
<tr><td colspan="6">No tasks yet.</td></tr>
{% endfor %}
</tbody>
</table>
</div>
</form>
{% endblock %}
